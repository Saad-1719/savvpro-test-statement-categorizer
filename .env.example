# No secrets are needed. Copy to .env only to override defaults.

# Backend (read by backend/app/config.py; every value below is the default)
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=5
SESSION_TTL_MINUTES=120
MAX_SESSIONS=100
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
